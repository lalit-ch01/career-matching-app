# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All of these are server-side only — none are exposed to the browser.

# --- Database (Supabase Postgres) ---------------------------------------------
# Supabase dashboard -> your project -> Connect -> Direct -> "Session pooler" URI
# (port 5432). Replace [YOUR-PASSWORD] with your database password.
# Do NOT use the "Transaction pooler" (port 6543) — the app refuses it, because
# it can mix up the results of queries that run in parallel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: a different connection for `npm run db:migrate` / `db:seed`.
# Falls back to DATABASE_URL.
# DATABASE_URL_DIRECT=

# Maximum database connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# --- Sessions -------------------------------------------------------------------
# Random secret (32+ characters) used to sign the student session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
